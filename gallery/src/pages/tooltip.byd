use material as m

// m.Tooltip, plain and rich, over an icon button.

View TooltipPage() {
    inject Theme as t
    Column #[p: 24, gap: 32, bg: t.surface, grow: 1] {
        Section("Plain") {
            Row #[gap: 24, p: (64, 24, 0, 24)] {
                m.Tooltip("Add to favourites") { m.IconButton("favorite", label: "Favourite") }
                m.Tooltip("Share", slot: 1) { m.IconButton("share", label: "Share") }
            }
        }
        Section("Rich") {
            Row #[gap: 24, p: (128, 24, 0, 24)] {
                m.Tooltip("Sync keeps your files up to date on every device you sign in on.",
                    variant: .rich, title: "Sync", slot: 2,
                    actions: { m.Button("Learn more", variant: .text, size: .xs) }) {
                    m.IconButton("sync", label: "Sync")
                }
                m.Tooltip("Rich tooltips can be text alone.", variant: .rich, slot: 3) {
                    m.IconButton("info", label: "Info")
                }
            }
        }
    }
}

View TooltipScenarios() {
    inject Theme as t
    var learned = 0
    Column #[p: (96, 24, 24, 24), gap: 16, align: start, bg: t.surface, grow: 1] {
        m.Tooltip("Add to favourites") { m.IconButton("favorite", label: "Favourite") }
        m.Tooltip("Sync keeps files current.", variant: .rich, title: "Sync", slot: 1,
            actions: { m.Button("Learn more", variant: .text, size: .xs, on_tap: { learned = learned + 1 }) }) {
            m.IconButton("sync", label: "Sync")
        }
        Text("Learned {learned}")
    }
}
