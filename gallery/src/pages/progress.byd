use material as m

// m.LinearProgressIndicator and m.CircularProgressIndicator: determinate at several values,
// indeterminate, flat and wavy.

View ProgressPage() {
    inject Theme as t
    Column #[p: 24, gap: 32, bg: t.surface, grow: 1] {
        Section("Linear, determinate") {
            Line("flat 0%") { m.LinearProgressIndicator(value: 0.0, label: "Flat empty") }
            Line("flat 30%") { m.LinearProgressIndicator(value: 0.3, label: "Flat 30") }
            Line("flat 75%") { m.LinearProgressIndicator(value: 0.75, label: "Flat 75") }
            Line("flat 100%") { m.LinearProgressIndicator(value: 1.0, label: "Flat full") }
            Line("wavy 0%") { m.LinearProgressIndicator(value: 0.0, wavy: true, label: "Wavy empty") }
            Line("wavy 30%") { m.LinearProgressIndicator(value: 0.3, wavy: true, label: "Wavy 30") }
            Line("wavy 75%") { m.LinearProgressIndicator(value: 0.75, wavy: true, label: "Wavy 75") }
            Line("wavy 100%") { m.LinearProgressIndicator(value: 1.0, wavy: true, label: "Wavy full") }
        }
        Section("Linear, indeterminate") {
            Line("flat") { m.LinearProgressIndicator(indeterminate: true, label: "Flat loading") }
            Line("wavy") { m.LinearProgressIndicator(indeterminate: true, wavy: true, label: "Wavy loading") }
        }
        Section("Circular, determinate") {
            Line("flat") {
                m.CircularProgressIndicator(value: 0.0, label: "Circle empty")
                m.CircularProgressIndicator(value: 0.3, label: "Circle 30")
                m.CircularProgressIndicator(value: 0.75, label: "Circle 75")
                m.CircularProgressIndicator(value: 1.0, label: "Circle full")
            }
            Line("wavy") {
                m.CircularProgressIndicator(value: 0.0, wavy: true, label: "Wavy circle empty")
                m.CircularProgressIndicator(value: 0.3, wavy: true, label: "Wavy circle 30")
                m.CircularProgressIndicator(value: 0.75, wavy: true, label: "Wavy circle 75")
                m.CircularProgressIndicator(value: 1.0, wavy: true, label: "Wavy circle full")
            }
        }
        Section("Circular, indeterminate") {
            Line("flat, wavy") {
                m.CircularProgressIndicator(indeterminate: true, label: "Circle loading")
                m.CircularProgressIndicator(indeterminate: true, wavy: true, label: "Wavy circle loading")
            }
        }
        Section("Driven by a slider") { DrivenProgress() }
    }
}

View DrivenProgress() {
    var v = 0.4
    Column #[gap: 16] {
        m.Slider(bind: v, label: "Value", min: 0.0, max: 1.0)
        m.LinearProgressIndicator(value: v, wavy: true, label: "Driven")
    }
}

View ProgressScenarios() {
    inject Theme as t
    var on = true
    Column #[p: 24, gap: 16, align: start, bg: t.surface, grow: 1] {
        m.LinearProgressIndicator(value: 0.4, label: "Upload")
        m.LinearProgressIndicator(value: 0.4, wavy: true, label: "Wavy upload", animated: false)
        m.CircularProgressIndicator(value: 0.25, label: "Download")
        m.CircularProgressIndicator(label: "Spinner", indeterminate: true)
        m.Button(on ? "Stop" : "Start", on_tap: { on = !on })
        when on {
            m.LinearProgressIndicator(indeterminate: true, label: "Working")
        }
    }
}
