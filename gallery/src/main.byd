use material as m

// The gallery: an index of the components, and a page for each. Every page is a view of its
// own, so `byard shot . --view ButtonPage` draws it without going through the index, and
// `tests/` drives it the same way.
enum Page {
    index,
    button,
    iconButton,
    buttonGroup,
    splitButton,
    fab,
    textField,
    chips,
}

View Main() {
    inject Theme as t

    var page = Page.index

    Column #[bg: t.surface, grow: 1] {
        Row #[p: (16, 24), gap: 16, align: center, bg: t.surfaceContainer] {
            Text("Byard Material") #[typo: t.titleLarge, color: t.onSurface]
            when page != Page.index {
                m.Button("All components", variant: .text, size: .xs, on_tap: { page = Page.index })
            }
        }
        ScrollView #[grow: 1] {
            when page == Page.button {
                ButtonPage()
            } else when page == Page.iconButton {
                IconButtonPage()
            } else when page == Page.buttonGroup {
                ButtonGroupPage()
            } else when page == Page.splitButton {
                SplitButtonPage()
            } else when page == Page.fab {
                FabPage()
            } else when page == Page.textField {
                TextFieldPage()
            } else when page == Page.chips {
                ChipsPage()
            } else {
                Column #[p: 24, gap: 16, align: start] {
                    Text("Components") #[typo: t.titleMedium, color: t.primary]
                    m.Button("Button", variant: .tonal, on_tap: { page = Page.button })
                    m.Button("IconButton", variant: .tonal, on_tap: { page = Page.iconButton })
                    m.Button("ButtonGroup", variant: .tonal, on_tap: { page = Page.buttonGroup })
                    m.Button("SplitButton", variant: .tonal, on_tap: { page = Page.splitButton })
                    m.Button("Fab", variant: .tonal, on_tap: { page = Page.fab })
                    m.Button("TextField", variant: .tonal, on_tap: { page = Page.textField })
                    m.Button("Chips", variant: .tonal, on_tap: { page = Page.chips })
                }
            }
        }
    }
}
