// Material 3 dialog: a basic one (icon, headline, supporting text, actions) centred over a
// scrim, and a full-screen one (a header with a close button, a headline and an action, and
// the content under it).
//
//     m.Dialog(bind: open, headline: "Discard draft?", supporting_text: "It will be deleted.",
//         icon: "delete", actions: {
//             m.Button("Cancel", variant: .text, on_tap: { open = false })
//             m.Button("Discard", variant: .text, on_tap: { discard() })
//         })
//     m.Dialog(bind: open, headline: "New event", fullscreen: true,
//         actions: { m.Button("Save", variant: .text, on_tap: { save() }) }) { fields() }
//
// A dialog is an `Overlay`: it is there while `open` is true. A tap on the scrim or Escape
// writes `open = false`. The scrim is the theme's `scrim` at 32%, which the engine draws.
// A full-screen dialog has no scrim to tap, so Escape and its close button dismiss it.
//
// Focus goes into the dialog when it opens: to the first action (Material puts it on the
// dismissive one, so a stray Enter does not confirm), and back to the button that opened it
// when it closes. Tab stays inside, Escape closes. It fades and scales in, and out.
//
// Measurements (starred: not sure of them)
//   basic: container surface_container_high, corner 28, padding 24, width 280 to 560, level 3
//          icon 24 secondary, 16 under it; headline headline_small on_surface, 16 under it;
//          supporting body_medium on_surface_variant, 24 under it; actions gap 8, end aligned
//   full screen: container surface, header 56 high*, close button 48*, headline title_large*,
//          horizontal padding 24*

View Dialog(bind open: Bool, headline: Str, supporting_text: Str = "", icon: Str = "",
    fullscreen: Bool = false, close_label: Str = "Close", actions: Slot = none, content) {
    inject Theme as t

    // The supporting text is always drawn, empty when there is none, because what describes
    // the dialog has to be tagged outside a `when` and must be a node of its own (a bare `Text`
    // cannot be pointed at): a group named by the text, hidden when it is empty.
    when open {
        Overlay #[dismiss => open = false] {
            when fullscreen {
                Column #[
                    bg: t.surface,
                    grow: 1,
                    opacity: 1.0 with t.springEffectsFast,
                    translate: (0, 0) with t.springSpatialDefault,
                    a11y_role: dialog,
                    a11y_label: headline,
                    a11y_described_by: body,
                    // A press on a bare part of the page is not a press on the scrim: without a
                    // handler the overlay takes it for one and dismisses.
                    tap => {},
                ] {
                    on enter { opacity: 0.0, translate: (0, 48) }
                    on leave { opacity: 0.0, translate: (0, 48) }
                    Row #[height: 56, p: (0, 24, 0, 8), gap: 8, align: center, shrink: 0] {
                        IconButton("close", label: close_label, on_tap: { open = false })
                        Text(headline) #[
                            typo: t.titleLarge,
                            color: t.onSurface,
                            grow: 1,
                            wrap: false,
                        ]
                        when actions != none { actions }
                    }
                    Column #[grow: 1, p: (8, 24, 24, 24)] {
                        Box #[
                            mb: supporting_text != "" ? 16 : 0,
                            a11y_role: group,
                            a11y_label: supporting_text,
                            a11y_hidden: supporting_text == "",
                        ] as body {
                            Text(supporting_text) #[
                                typo: t.bodyMedium,
                                color: t.onSurfaceVariant,
                                a11y_hidden: true,
                            ]
                        }
                        content
                    }
                }
            } else {
                Column #[
                    anchor: center,
                    bg: t.surfaceContainerHigh,
                    radius: t.cornerXl,
                    shadow: "lg",
                    p: 24,
                    min_width: 280,
                    max_width: 560,
                    opacity: 1.0 with t.springEffectsFast,
                    scale: 1.0 with t.springSpatialFast,
                    a11y_role: dialog,
                    a11y_label: headline,
                    a11y_described_by: body,
                ] {
                    on enter { opacity: 0.0, scale: 0.8 }
                    on leave { opacity: 0.0, scale: 0.8 }
                    when icon != "" {
                        Icon(icon, size: 24, color: t.secondary) #[align_self: center, mb: 16]
                    }
                    Text(headline) #[
                        typo: t.headlineSmall,
                        color: t.onSurface,
                        align_self: icon != "" ? center : start,
                    ]
                    Box #[
                        mt: supporting_text != "" ? 16 : 0,
                        a11y_role: group,
                        a11y_label: supporting_text,
                        a11y_hidden: supporting_text == "",
                    ] as body {
                        Text(supporting_text) #[
                            typo: t.bodyMedium,
                            color: t.onSurfaceVariant,
                            a11y_hidden: true,
                        ]
                    }
                    content
                    when actions != none {
                        Row #[gap: 8, justify: end, align: center, mt: 24] { actions }
                    }
                }
            }
        }
    }
}
