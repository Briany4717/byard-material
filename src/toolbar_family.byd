// What the docked and floating toolbars share. Private. Material 3 Expressive toolbars.

// Standard sits on `surface_container`; vibrant on `primary_container`.
enum ToolbarColor {
    standard,
    vibrant,
}

// Floating toolbars lie along either axis.
enum ToolbarOrientation {
    horizontal,
    vertical,
}

// The colour a toolbar gives the standard IconButtons drawn in it, so the caller writes none:
// `on_primary_container` on a vibrant toolbar. Outside a toolbar, or in a standard one, `tinted` is
// false and the button keeps its own colour. (`tinted` and not an optional `color`: a `none` from
// a `?:` arm reads as colour 0, not as nothing.)
private context ToolbarContent {
    tinted: Bool = false
    ink: Color = 0
}
