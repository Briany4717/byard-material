// Material 3 text field: filled and outlined, built on Byard's bare TextField.
//
//     m.TextField(bind: name, label: "Name", supporting_text: "As on your passport")
//     m.TextField(bind: email, label: "Email", variant: .outlined, error: bad,
//         error_text: "Not an address", leading_icon: "mail")
//
// `bind value` is the text. The label sits inside while the field is empty and unfocused and
// floats up (smaller, to the top edge; on an outlined field it notches the outline) once it has
// focus or text. The placeholder shows only with focus and no text. `max_length` caps the text
// and shows a counter; `prefix` and `suffix` show once the label has floated. `trailing_label`
// turns the trailing icon into an IconButton (a clear button) that calls `on_trailing_tap`; an
// error replaces the trailing icon with the error icon. `width` is the container's width.
// The field is named by its label; supporting and error text are the text lines after it.
// A single line only: Byard's TextField has no multiline mode.

enum TextFieldVariant {
    filled,
    outlined,
}

View TextField(bind value: Str, label: Str, variant: TextFieldVariant = .filled,
    placeholder: Str = "", supporting_text: Str = "", error: Bool = false,
    error_text: Str = "", max_length: Int = 0, prefix: Str = "", suffix: Str = "",
    leading_icon: Str = "", trailing_icon: Str = "", trailing_label: Str = "",
    width: Int = 280, disabled: Bool = false, on_trailing_tap: Fn() = {}) {
    inject Theme as t

    var focused = false
    var hovered = false

    let filled = variant == TextFieldVariant.filled
    let up = focused || value != ""
    let hasTrailingButton = trailing_label != "" && trailing_icon != "" && !error
    let hasTrailing = error || trailing_icon != ""

    // Container height 56 dp, icons 24 dp at 12 dp from the edge, text 16 dp from the edge (or
    // 16 dp after a leading icon).
    let left = leading_icon != "" ? 52 : 16
    let rightPad = hasTrailingButton ? 4 : hasTrailing ? 12 : 16

    let labelInk = disabled ? t.onSurface.alpha(disabledContent)
        : error ? t.error
        : focused ? t.primary
        : t.onSurfaceVariant
    let lineInk = disabled ? (filled ? t.onSurface.alpha(disabledContent) : t.onSurface.alpha(disabledContainer))
        : error ? t.error
        : focused ? t.primary
        : hovered ? t.onSurface
        : filled ? t.onSurfaceVariant : t.outline
    let lineWidth = focused ? 2 : 1
    let supportInk = disabled ? t.onSurface.alpha(disabledContent)
        : error ? t.error : t.onSurfaceVariant
    let textInk = disabled ? t.onSurface.alpha(disabledContent) : t.onSurface
    let iconInk = disabled ? t.onSurface.alpha(disabledContent) : error ? t.error : t.onSurfaceVariant

    let shown = error && error_text != "" ? error_text : supporting_text
    let hasFooter = shown != "" || max_length > 0

    Column #[width: width, shrink: 0] {
        ZStack #[width: width, height: 56, alignment: top_start] {
            // The container and what sits in it.
            Row #[
                width: width,
                height: 56,
                bg: filled ? (disabled ? t.onSurface.alpha(0.04) : t.surfaceContainerHighest) : t.surface.alpha(0.0),
                radius: (4, 4, filled ? 0 : 4, filled ? 0 : 4),
                border: lineInk,
                border_width: filled ? 0 : lineWidth,
                p: (0, rightPad, 0, leading_icon != "" ? 12 : 16),
                align: center,
                pointer_enter => hovered = true,
                pointer_exit => hovered = false,
            ] {
                on hover { overlay: t.onSurface.alpha(filled ? stateHover : 0.0) with t.springEffectsFast }

                when leading_icon != "" {
                    Icon(leading_icon, color: iconInk)
                }
                Row #[
                    grow: 1,
                    height: 24,
                    align: center,
                    ml: leading_icon != "" ? 16 : 0,
                    mt: filled ? 24 : 0,
                    mb: filled ? 8 : 0,
                ] {
                    when up && prefix != "" {
                        Text(prefix) #[
                            typo: t.bodyLarge,
                            color: t.onSurfaceVariant,
                            wrap: false,
                            shrink: 0,
                        ]
                    }
                    TextField #[
                        bind: value,
                        focused: focused,
                        disabled: disabled,
                        indicator: none,
                        grow: 1,
                        height: 24,
                        p: (horizontal: 0),
                        typo: t.bodyLarge,
                        color: textInk,
                        placeholder: focused ? placeholder : "",
                        a11y_label: label,
                        input(text) => {
                            if max_length > 0 && text.len > max_length {
                                value = text.slice(0, max_length)
                            }
                        },
                    ]
                    when up && suffix != "" {
                        Text(suffix) #[
                            typo: t.bodyLarge,
                            color: t.onSurfaceVariant,
                            wrap: false,
                            shrink: 0,
                        ]
                    }
                }
                when error {
                    Icon("error", color: t.error)
                } else when hasTrailingButton {
                    IconButton(trailing_icon, label: trailing_label, disabled: disabled, on_tap: on_trailing_tap)
                } else when trailing_icon != "" {
                    Icon(trailing_icon, color: iconInk)
                }
            }

            // The active indicator of a filled field.
            when filled {
                ZStack #[width: width, height: 56, alignment: bottom_start] {
                    Box #[width: width, height: lineWidth, bg: lineInk with t.springEffectsFast] {}
                }
            }

            // The label: resting inside, floated to the top edge. On an outlined field its
            // background cuts a notch in the outline.
            Text(label) #[
                typo: t.bodyLarge,
                color: labelInk with t.springEffectsFast,
                bg: (!filled && up) ? t.surface : t.surface.alpha(0.0),
                p: (horizontal: filled ? 0 : 4),
                wrap: false,
                origin: (0, 0),
                scale: up ? 0.75 : 1.0 with t.springSpatialFast,
                translate: (filled ? left : left - 4,
                    up ? (filled ? 8 : -9) : 16) with t.springSpatialFast,
                a11y_hidden: true,
            ]
        }

        when hasFooter {
            Row #[p: (4, 16, 0, 16), gap: 16, width: width] {
                Text(shown) #[typo: t.bodySmall, color: supportInk, grow: 1]
                when max_length > 0 {
                    Text("{value.len}/{max_length}") #[
                        typo: t.bodySmall,
                        color: disabled ? supportInk : t.onSurfaceVariant,
                        wrap: false,
                    ]
                }
            }
        }
    }
}
