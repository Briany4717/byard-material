// Material 3 tabs: primary and secondary, fixed (the tabs share the width) or scrollable (each
// is as wide as its label). One indicator slides to the selected tab.
//
//     var tab = 0
//
//     m.Tabs(bind: tab, label: "Trips") {
//         m.Tab(0, label: "Flights", icon: "flight")
//         m.Tab(1, label: "Hotels", icon: "hotel", on_select: { load() })
//         m.Tab(2, label: "Cars", badge: { Badge() })
//     }
//
// `Tabs` owns the selection: `bind: tab` makes it the caller's var (to show a screen with a
// `NavHost`, say), and leaving it out makes `Tabs` keep its own, starting at the first tab. What
// `Tabs` decides for every tab (`variant`, `scrollable`, the selected index, how to select) it
// hands down in a context, so a `Tab` is written with only what is its own: its `index`, label,
// icon and badge. A `Tab` drawn outside a `Tabs` has the defaults (primary, fixed, nothing
// selected, a tap does nothing). A tap, or Enter or Space, selects the tab and then calls
// `on_select`. `Tabs` is the `tab_list` a screen reader announces, and the engine makes it one Tab
// stop: Tab enters at the selected tab, the arrows (and Home and End) move focus along it. An
// arrow key moves focus without selecting, as Material's tabs do by default.
//
// The indicator is the list's: each tab reports where it is (`on measure`: `it.x`, `it.w`, and the
// width of its content) through the context's `place`, and the one indicator moves and resizes to
// the selected tab with a spatial spring, in a fixed list and a scrollable one alike.
//
//   primary    48 high (64 with an icon over its label), indicator 3 high, as wide as the
//              label or icon, top corners 3, `primary`; selected label `primary`
//   secondary  48 high, indicator 2 high, the width of the tab, `primary`; selected label
//              `on_surface`
//   both       label `title_small`, unselected `on_surface_variant`, divider 1 `outline_variant`
//              under the list, scrollable tabs at least 90 wide with 16 on a side

enum TabVariant {
    primary,
    secondary,
}

private let tabHeight = 48
private let tabStackedHeight = 64
private let tabMinWidth = 90
private let tabPadding = 16
private let tabIconSize = 24
private let tabDivider = 1

// What `Tabs` decides for its tabs. Private: only `Tab` reads it.
private context TabsStyle {
    variant: TabVariant = .primary
    scrollable: Bool = false
    current: Int = -1
    select: Fn(Int) = none
    place: Fn(Int, Float, Float) = none
}

View Tabs(content, bind current: Int = 0, label: Str = "", variant: TabVariant = .primary,
    scrollable: Bool = false) {
    inject Theme as t

    // Where the selected tab is (its indicator's place), reported by the tabs.
    var ix: Float = 0.0
    var iw: Float = 0.0

    provide TabsStyle(
        variant: variant,
        scrollable: scrollable,
        current: current,
        select: {|i| current = i },
        place: {|i, x, w|
            ix = i == current ? x : ix
            iw = i == current ? w : iw
        },
    )

    Column {
        when scrollable {
            ScrollView #[axis: horizontal] {
                TabsList(label: label, variant: variant, ix: ix, iw: iw) { content }
            }
        } else {
            TabsList(label: label, variant: variant, ix: ix, iw: iw) { content }
        }
        Box #[height: tabDivider, bg: t.outlineVariant, align_self: stretch] {}
    }
}

// The row of tabs and the indicator under it.
private View TabsList(content, label: Str, variant: TabVariant, ix: Float, iw: Float) {
    inject Theme as t

    let primary = variant == TabVariant.primary

    ZStack #[alignment: bottom_start, align_self: stretch] {
        Row #[a11y_role: tab_list, a11y_label: label, align_self: stretch] {
            content
        }
        Box #[
            height: primary ? 3 : 2,
            width: iw with t.springSpatialFast,
            translate.x: ix with t.springSpatialFast,
            bg: t.primary,
            radius: primary ? (3, 3, 0, 0) : 0,
            interactive: false,
        ] {}
    }
}

View Tab(index: Int, label: Str, icon: Str = "", badge: Slot = none, disabled: Bool = false,
    on_select: Fn() = {}) {
    inject Theme as t
    inject TabsStyle as s

    let on = s.current == index
    let primary = s.variant == TabVariant.primary
    let scrollable = s.scrollable
    let stacked = icon != "" && label != ""

    // Measured, so the list can put its indicator under this tab (or under its content).
    var tabX: Float = 0.0
    var tabWidth: Float = 0.0
    var contentWidth: Float = 0.0

    let ink = disabled ? t.onSurface.alpha(disabledContent)
        : on ? (primary ? t.primary : t.onSurface)
        : t.onSurfaceVariant
    // The state layer: `primary` under a selected primary tab, `on_surface` elsewhere.
    let layer = disabled ? t.onSurface : (primary && on) ? t.primary : t.onSurface

    // A tab that does not move is not measured again, so the one that becomes selected reports
    // again, and so does one whose content changed.
    on change(s.current) => s.place(index, primary ? tabX + (tabWidth - contentWidth) / 2 : tabX,
        primary ? contentWidth : tabWidth)

    Column #[
        height: stacked ? tabStackedHeight : tabHeight,
        grow: scrollable ? 0 : 1,
        basis: scrollable ? () : 0,
        shrink: 0,
        min_width: scrollable ? tabMinWidth : 0,
        p: (0, scrollable ? tabPadding : 0),
        a11y_role: tab,
        a11y_selected: on,
        a11y_label: label,
        disabled: disabled,
        tap => {
            s.select(index)
            on_select()
        },
    ] as tab {
        on measure => {
            tabX = it.x
            tabWidth = it.w
            s.place(index, primary ? it.x + (it.w - contentWidth) / 2 : it.x,
                primary ? contentWidth : it.w)
        }
        on hover { overlay: layer.alpha(stateHover) with t.springEffectsFast }
        on focus_visible {
            overlay: layer.alpha(stateFocus) with t.springEffectsFast
            outline: t.secondary
            outline_width: focusRingWidth
            outline_offset: scrollable ? -focusRingWidth : focusRingOffset
        }
        on pressed { overlay: layer.alpha(statePress) with t.springEffectsFast }

        Box #[grow: 1, align: center, justify: center, align_self: stretch] {
            Column #[align: center, gap: 2] {
                on measure => {
                    contentWidth = it.w
                    s.place(index, primary ? tabX + (tabWidth - it.w) / 2 : tabX,
                        primary ? it.w : tabWidth)
                }

                when icon != "" {
                    ZStack #[alignment: top_start] {
                        Icon(icon, fill: on ? 1.0 : 0.0, size: tabIconSize, color: ink)
                        when badge != none {
                            Box #[ml: 14, mt: -2] { badge }
                        }
                    }
                }
                when label != "" {
                    Row #[gap: 6, align: center] {
                        Text(label) #[
                            typo: t.titleSmall,
                            color: ink with t.springEffectsFast,
                            wrap: false,
                        ]
                        when icon == "" && badge != none {
                            badge
                        }
                    }
                }
            }
        }
    }
}
