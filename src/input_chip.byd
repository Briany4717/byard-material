// Material 3 input chip: a piece of information the user entered, such as a recipient or a tag.
// Flat (outlined) only; Material has no elevated input chip. An optional avatar (an image or
// initials, drawn by the caller as `avatar`) or leading icon, and a trailing remove button of
// its own that calls `on_remove`. Tapping the chip itself calls `on_tap` (edit, usually);
// The remove button is focusable and takes Space and Enter;
// Backspace and Delete on the chip itself are not wired (a Row has no `key_down`, see notes).
//
//     m.InputChip("Ana", icon: "person", on_remove: { people.remove(0) })

View InputChip(label: Str, selected: Bool = false, icon: Str = "", avatar: Str = "",
    disabled: Bool = false, on_tap: Fn() = {}, on_remove: Fn() = {}) {
    inject Theme as t

    let hasAvatar = avatar != ""
    let lead = hasAvatar || icon != ""

    let container = disabled ? (selected ? t.onSurface.alpha(disabledContainer) : t.surface.alpha(0.0))
        : selected ? t.secondaryContainer : t.surface.alpha(0.0)
    let ink = disabled ? t.onSurface.alpha(disabledContent)
        : selected ? t.onSecondaryContainer : t.onSurfaceVariant
    let iconInk = disabled ? t.onSurface.alpha(disabledContent)
        : selected ? t.onSecondaryContainer : t.primary
    let line = disabled ? t.onSurface.alpha(disabledContainer) : t.outlineVariant

    Row #[
        bg: container with t.springEffectsFast,
        radius: hasAvatar ? chipHeight / 2 : t.cornerSm,
        border: line,
        border_width: selected ? 0 : chipLineWidth,
        height: chipHeight,
        pl: hasAvatar ? 4 : lead ? 8 : 16,
        pr: 8,
        gap: chipGap,
        shrink: 0,
        align: center,
        a11y_role: button,
        a11y_selected: selected,
        disabled: disabled,
        tap => on_tap(),
    ] {
        on hover { overlay: ink.alpha(stateHover) with t.springEffectsFast }
        on focus_visible {
            overlay: ink.alpha(stateFocus) with t.springEffectsFast
            outline: t.secondary
            outline_width: focusRingWidth
            outline_offset: focusRingOffset
        }
        on pressed { overlay: ink.alpha(statePress) with t.springEffectsFast }

        when hasAvatar {
            Row #[
                width: chipAvatarSize,
                height: chipAvatarSize,
                radius: chipAvatarSize / 2,
                bg: disabled ? t.onSurface.alpha(disabledContainer) : t.primaryContainer,
                shrink: 0,
                align: center,
                justify: center,
                a11y_hidden: true,
            ] {
                Text(avatar) #[
                    typo: t.labelSmall,
                    color: disabled ? t.onSurface.alpha(disabledContent) : t.onPrimaryContainer,
                ]
            }
        } else when icon != "" {
            Icon(icon, size: chipIconSize, color: iconInk)
        }
        Text(label) #[typo: t.labelLarge, color: ink with t.springEffectsFast, wrap: false]
        Box #[
            width: 24,
            height: 24,
            radius: 12,
            shrink: 0,
            align: center,
            justify: center,
            a11y_role: button,
            a11y_label: "Remove {label}",
            disabled: disabled,
            tap => on_remove(),
        ] {
            on hover { overlay: ink.alpha(stateHover) with t.springEffectsFast }
            on focus_visible {
                overlay: ink.alpha(stateFocus) with t.springEffectsFast
                outline: t.secondary
                outline_width: focusRingWidth
                outline_offset: focusRingOffset
            }
            on pressed { overlay: ink.alpha(statePress) with t.springEffectsFast }
            Icon("close", size: chipIconSize, color: ink)
        }
    }
}
