// Material 3 Expressive button: filled, tonal, outlined, elevated and text; five sizes;
// round or square; a toggle that swaps its shape and fills its icon when selected. The
// corners spring to a tighter square while it is pressed.
//
//     m.Button("Save", icon: "check", on_tap: { save() })
//     m.Button("Star", variant: .tonal, toggle: true, selected: starred,
//         on_tap: { starred = !starred })
//
// A view takes its action by name (`on_tap`), not as a trailing `=> action`. The text variant
// has no selected look in Material; `toggle` on it only changes what a screen reader says.

enum ButtonVariant {
    filled,
    tonal,
    outlined,
    elevated,
    text,
}

View Button(label: Str, variant: ButtonVariant = .filled, size: ButtonSize = .s,
    shape: ButtonShape = .round, icon: Str = "", toggle: Bool = false, selected: Bool = false,
    disabled: Bool = false, on_tap: Fn() = {}) {
    inject Theme as t

    // A toggle that is on takes the opposite of its resting shape.
    let on = toggle && selected
    let flat = variant == ButtonVariant.outlined || variant == ButtonVariant.text

    let h = buttonHeight(size)

    let container = disabled ? (flat ? t.surface.alpha(0.0) : t.onSurface.alpha(disabledContainer))
        : variant == ButtonVariant.filled ? (toggle && !selected ? t.surfaceContainer : t.primary)
        : variant == ButtonVariant.tonal ? (toggle && selected ? t.secondary : t.secondaryContainer)
        : variant == ButtonVariant.elevated ? (toggle && selected ? t.primary : t.surfaceContainerLow)
        : variant == ButtonVariant.outlined ? (on ? t.inverseSurface : t.surface.alpha(0.0))
        : t.surface.alpha(0.0)
    let ink = disabled ? t.onSurface.alpha(disabledContent)
        : variant == ButtonVariant.filled ? (toggle && !selected ? t.onSurfaceVariant : t.onPrimary)
        : variant == ButtonVariant.tonal ? (toggle && selected ? t.onSecondary : t.onSecondaryContainer)
        : variant == ButtonVariant.elevated ? (toggle && selected ? t.onPrimary : t.primary)
        : variant == ButtonVariant.outlined ? (on ? t.inverseOnSurface : t.onSurfaceVariant)
        : t.primary

    // The outline of an outlined button, thicker on the large sizes.
    let outlined = variant == ButtonVariant.outlined && !on
    let line = disabled ? t.onSurface.alpha(disabledContainer) : t.outlineVariant
    let lineWidth = size == ButtonSize.l ? 2 : size == ButtonSize.xl ? 3 : 1

    let square = (shape == ButtonShape.square) != on
    let r = square ? buttonSquareRadius(size) : h / 2

    // Elevation: an elevated button rests at level 1 and rises to level 2 under the pointer; a
    // filled or tonal one rises to level 1. The presets stand for the levels ("sm" is 1,
    // "md" is 2).
    let restShadow = !disabled && variant == ButtonVariant.elevated ? "sm" : ()
    let hoverShadow = (disabled || flat) ? () : variant == ButtonVariant.elevated ? "md" : "sm"

    Row #[
        bg: container with t.springEffectsFast,
        radius: r with t.springSpatialFast,
        border: line,
        border_width: outlined ? lineWidth : 0,
        shadow: restShadow,
        height: h,
        p: (0, buttonPadding(size)),
        gap: buttonGap(size),
        align: center,
        justify: center,
        a11y_role: toggle ? toggle_button : button,
        a11y_checked: selected,
        disabled: disabled,
        tap => on_tap(),
    ] {
        on hover { overlay: ink.alpha((disabled ? 0.0 : stateHover) with t.springEffectsFast), shadow: hoverShadow }
        on focus_visible {
            overlay: ink.alpha((disabled ? 0.0 : stateFocus) with t.springEffectsFast)
            outline: t.secondary
            outline_width: focusRingWidth
            outline_offset: focusRingOffset
        }
        on pressed {
            overlay: ink.alpha((disabled ? 0.0 : statePress) with t.springEffectsFast)
            radius: (disabled ? r : buttonPressedRadius(size)) with t.springSpatialFast
        }

        when icon != "" {
            Icon(icon, fill: on ? 1.0 : 0.0, size: buttonIconSize(size), color: ink)
        }
        Text(label) #[
            typo: (size == ButtonSize.xs || size == ButtonSize.s) ? t.labelLarge : size == ButtonSize.m ? t.titleMedium : size == ButtonSize.l ? t.headlineSmall : t.headlineLarge,
            color: ink with t.springEffectsFast,
            wrap: false,
        ]
    }
}
