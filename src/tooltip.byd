// Material 3 tooltip: plain (a short label) or rich (a title, text and actions), anchored to the
// control it describes.
//
//     m.Tooltip("Add to favourites") { m.IconButton("favorite", label: "Favourite") }
//     m.Tooltip("Sync keeps your files up to date on every device.", variant: .rich,
//         title: "Sync", actions: { m.Button("Learn more", variant: .text) }) {
//         m.IconButton("sync", label: "Sync")
//     }
//
// It fades in 500 ms after the pointer rests on the target, at once on a long press and on
// keyboard focus (anything inside the target taking focus), and fades out when they stop. A
// plain one goes when the pointer leaves, when the target is pressed or on Escape; a rich one
// stays while the pointer is on it, so its actions can be reached, and a press elsewhere or
// Escape closes it. It sits above the target, centred, 4 dp off, and flips below when there is
// no room.
//
// The wrapper around the target listens for `pointer_enter`/`pointer_leave`, `focus_in`/
// `focus_out` and `long_press`, which fire for whatever the slot holds. The panel is mounted
// while it is wanted. The fade in is a `from: 0.0` with the hover delay as its delay, and the
// fade out is `on leave` (`on enter` with a delayed `with` ignores the delay: see the notes), so a pointer that has just arrived has a panel at no opacity, and a plain one lets
// the pointer through (`interactive: false`). The target is described by the tooltip's text
// (`a11y_described_by`), so a screen reader says it after the control's own name.

enum TooltipVariant {
    plain,
    rich,
}

View Tooltip(text: Str, content: Slot, variant: TooltipVariant = .plain, title: Str = "",
    actions: Slot = none) {
    inject Theme as t

    var hovering = false
    var pressed = false
    var focused = false
    var overTip = false
    var dismissed = false

    let rich = variant == TooltipVariant.rich
    let open = !dismissed && (hovering || pressed || focused || (rich && overTip))
    // Only a resting pointer waits; focus and a long press are answers to the person at once.
    let wait = (hovering && !pressed && !focused && !overTip) ? 500ms : 0ms
    // A long press keeps it up for a moment after the finger is lifted.
    when pressed {
        after 1500ms => pressed = false
    }

    ZStack #[
        alignment: top_start,
        shrink: 0,
        pointer_enter => {
            hovering = true
            dismissed = false
        },
        pointer_leave => hovering = false,
        pointer_down => dismissed = true,
        focus_in => focused = true,
        focus_out => {
            focused = false
            dismissed = false
        },
        long_press => {
            pressed = true
            dismissed = false
        },
        a11y_role: group,
        a11y_described_by: tip,
    ] as target {
        content

        // What the target is described by. A name declared inside the `when` below is not in
        // scope here, so the description lives in a node of no size that is always there.
        Box #[
            width: 0,
            height: 0,
            interactive: false,
            a11y_role: group,
            a11y_label: text,
        ] as tip

        when open && !rich {
            Overlay #[modal: false] {
                Box #[
                    anchor_to: target,
                    anchor_edge: above,
                    anchor_align: center,
                    anchor_gap: 4,
                    interactive: false,
                    dismiss => dismissed = true,
                ] {
                    Box #[
                        bg: t.inverseSurface,
                        radius: t.cornerXs,
                        min_width: 40,
                        max_width: 200,
                        min_height: 24,
                        p: (4, 8),
                        align: center,
                        justify: center,
                        opacity: 1.0 with anim.ease(t.durationShort3, delay: wait, from: 0.0),
                    ] {
                        on leave { opacity: 0.0 }

                        Text(text) #[typo: t.bodySmall, color: t.inverseOnSurface]
                    }
                }
            }
        }
        // A rich one is reachable, so the 4 dp between it and the target is padding of the
        // anchored box: the pointer crosses from one to the other without leaving both.
        when open && rich {
            Overlay #[modal: false] {
                Box #[
                    anchor_to: target,
                    anchor_edge: above,
                    anchor_align: center,
                    pb: 4,
                    dismiss => dismissed = true,
                    pointer_enter => overTip = true,
                    pointer_leave => overTip = false,
                ] {
                    Column #[
                        bg: t.surfaceContainer,
                        radius: t.cornerMd,
                        shadow: "md",
                        min_width: 112,
                        max_width: 312,
                        p: (12, 16),
                        gap: 4,
                        opacity: 1.0 with anim.ease(t.durationShort3, delay: wait, from: 0.0),
                    ] {
                        on leave { opacity: 0.0 }

                        when title != "" {
                            Text(title) #[typo: t.titleSmall, color: t.onSurfaceVariant]
                        }
                        Text(text) #[typo: t.bodyMedium, color: t.onSurfaceVariant]
                        when actions != none {
                            Row #[gap: 8, mt: 8, ml: -12] {
                                actions
                            }
                        }
                    }
                }
            }
        }
    }
}
