// Material 3 Expressive floating action button: small, medium (the default) and large; the
// three container colours and the three filled ones; a lowered option for a FAB that sits on
// a surface of its own.
//
//     m.Fab("edit", label: "Compose", on_tap: { compose() })
//     m.Fab("add", label: "New", size: .large, color: .tertiary, lowered: true)
//
// `label` is what a screen reader says: a FAB has no text of its own. A FAB is not disabled in
// Material: hide it instead.
//
// Elevation, Material's levels: a FAB rests at level 3 ("lg"), lifts to 4 ("xl") under the pointer
// and is at 3 again focused or pressed; lowered, level 1 ("sm") and 2 ("md") under the pointer.

View Fab(icon: Str, label: Str, size: FabSize = .medium, color: FabColor = .primaryContainer,
    lowered: Bool = false, on_tap: Fn() = none) {
    inject Theme as t

    let d = fabSize(size)

    let container = color == FabColor.primaryContainer ? t.primaryContainer
        : color == FabColor.secondaryContainer ? t.secondaryContainer
        : color == FabColor.tertiaryContainer ? t.tertiaryContainer
        : color == FabColor.primary ? t.primary
        : color == FabColor.secondary ? t.secondary
        : t.tertiary
    let ink = color == FabColor.primaryContainer ? t.onPrimaryContainer
        : color == FabColor.secondaryContainer ? t.onSecondaryContainer
        : color == FabColor.tertiaryContainer ? t.onTertiaryContainer
        : color == FabColor.primary ? t.onPrimary
        : color == FabColor.secondary ? t.onSecondary
        : t.onTertiary

    Box #[
        bg: container with t.springEffectsFast,
        radius: fabRadius(size) with t.springSpatialFast,
        shadow: (lowered ? "sm" : "lg") with t.springEffectsFast,
        width: d,
        height: d,
        shrink: 0,
        align: center,
        justify: center,
        a11y_role: button,
        a11y_label: label,
        tap => on_tap(),
    ] {
        on hover {
            overlay: ink.alpha(stateHover) with t.springEffectsFast
            shadow: lowered ? "md" : "xl"
        }
        on focus_visible {
            overlay: ink.alpha(stateFocus) with t.springEffectsFast
            outline: t.secondary
            outline_width: focusRingWidth
            outline_offset: focusRingOffset
        }
        on pressed {
            overlay: ink.alpha(statePress) with t.springEffectsFast
            radius: fabPressedRadius(size) with t.springSpatialFast
        }

        Icon(icon, size: fabIconSize(size), color: ink)
    }
}
