// Material 3 Expressive card: elevated, filled and outlined, with a slot for its content.
//
//     m.Card(variant: .outlined) { Text("Hello") }
//     m.Card(label: "Open trip", on_tap: { open() }) { ... }
//
// A card given `on_tap` is one element with the role of a button, the tap, a state layer on
// hover, focus and press, a keyboard ring, and `label` for its name (its text when `label` is
// empty). A card without it is inert: no state layer, no role, not focusable. Controls inside a
// clickable card keep their own taps.
//
// A disabled card dims its container and outline, and its content (the slot) to 38%.

enum CardVariant {
    elevated,
    filled,
    outlined,
}

View Card(variant: CardVariant = .elevated, disabled: Bool = false, label: Str = "",
    padding: Int = 16, on_tap: Fn() = none, content) {
    inject Theme as t

    let elevated = variant == CardVariant.elevated
    let outlined = variant == CardVariant.outlined

    // Containers: elevated surface_container_low, filled surface_container_highest, outlined
    // surface. Disabled: the same roles at 38% (my reading of the spec, see the notes).
    let container = variant == CardVariant.filled ? t.surfaceContainerHighest
        : outlined ? t.surface : t.surfaceContainerLow
    let shown = disabled ? container.alpha(0.38) : container
    let line = disabled ? t.outline.alpha(disabledContainer) : t.outlineVariant

    // Elevation: elevated rests at level 1 and rises to 2 under the pointer; filled rises from
    // 0 to 1; outlined stays flat. "sm" is level 1, "md" level 2. No state needs 3 to 5.
    let restShadow = elevated && !disabled ? "sm" : ()
    let hoverShadow = elevated ? "md" : outlined ? () : "sm"

    when on_tap != none {
        Column #[
            bg: shown with t.springEffectsFast,
            radius: t.cornerMd,
            border: line,
            border_width: outlined ? 1 : 0,
            shadow: restShadow,
            p: padding,
            a11y_role: button,
            a11y_label: label,
            disabled: disabled,
            tap => on_tap(),
        ] {
            on hover {
                overlay: t.onSurface.alpha(stateHover) with t.springEffectsFast
                shadow: hoverShadow
            }
            on focus_visible {
                overlay: t.onSurface.alpha(stateFocus) with t.springEffectsFast
                outline: t.secondary
                outline_width: focusRingWidth
                outline_offset: focusRingOffset
            }
            on pressed { overlay: t.onSurface.alpha(statePress) with t.springEffectsFast }

            Column #[opacity: disabled ? disabledContent : 1.0 with t.springEffectsFast] { content }
        }
    } else {
        Column #[
            bg: shown with t.springEffectsFast,
            radius: t.cornerMd,
            border: line,
            border_width: outlined ? 1 : 0,
            shadow: restShadow,
            p: padding,
        ] {
            Column #[opacity: disabled ? disabledContent : 1.0 with t.springEffectsFast] { content }
        }
    }
}
