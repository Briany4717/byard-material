// The indicator's thickness, the gap between the active part and the track, and the stop
// indicator (a dot, in the last stretch of a linear track).
private let progressThickness = 4.0
private let progressGap = 4.0
private let progressStopSize = 4.0
private let progressStopInset = 6.0

// The wave: its amplitude eases in over the first 10% and out over the last 5% of a
// determinate value, so a nearly empty or full bar is flat.
private fn waveRamp(v: Float) -> Float => v < 0.1 ? v / 0.1 : v > 0.95 ? (1.0 - v) / 0.05 : 1.0

// Clamp a value to 0..1.
private fn unit(v: Float) -> Float => v < 0.0 ? 0.0 : v > 1.0 ? 1.0 : v

// A travelling sine: `u` is how many wavelengths along, `p` how far through the one-second
// cycle (0 to 100), so the wave moves one wavelength a cycle. A wave that moves is a stroked
// path whose points are keyframed over eight stops of that cycle (a sine moves by less than
// 0.25 dp between stops); a still one is the same path at `p = 0`.
private fn wsin(u: Float, p: Float) -> Float => (6.2831853 * (u - p / 100.0)).sin()
