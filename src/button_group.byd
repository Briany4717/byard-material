// Material 3 Expressive button group, standard and connected.
//
// A standard group is buttons with a gap between them: the one under the finger widens and its
// neighbours narrow. A connected group is a segmented control: the outer corners of the first
// and last are fully round, the corners between them small, and a selected item rounds fully.
// Selection is none (plain buttons), single (one index) or multi (any number).
//
//     m.ButtonGroup(["Day", "Week", "Month"])                       // keeps its own selection
//     m.ButtonGroup(["Day", "Week", "Month"], bind: range)          // var range = 0
//     m.MultiButtonGroup(["Bold", "Italic"], icons: ["format_bold", "format_italic"],
//         type: .connected, bind: styles)                           // var styles: List<Int> = []
//
// `ButtonGroup` selects one item and binds its index; with no `bind` it keeps the index itself,
// starting at 0. `selectable: false` makes plain buttons that only report `on_tap(index)`.
// `MultiButtonGroup` is the same group where any number are on, bound to a list of indices
// (empty to start). `icon_only` hides the labels but keeps them for a screen reader.
//
// A standard group's pressed item grows by 15% of its width (Compose's `ExpandedRatio`) and the
// ones beside it give that width up, on a spatial spring (padding with motion), as Compose does:
// a middle item grows half the ratio on each side and takes it from both neighbours, the first
// or last item grows the whole ratio on its inner side; no neighbour gives up more than its own
// side padding. In a connected group the corners between items, and those of a selected item,
// move on the same spring.
//
// The items are toggle buttons in a `group`. Material says nothing I could find about arrow
// keys in a button group, so Tab walks the items and Space or Enter presses one.

enum ButtonGroupType {
    standard,
    connected,
}

// The space between items. A standard group's falls as the buttons grow; a connected group's is
// a hairline.
//   size   standard  connected
//   xs        18         2
//   s         12         2
//   m          8         2
//   l          8         2
//   xl         8         2
private fn groupGap(size: ButtonSize, type: ButtonGroupType) -> Int =>
    type == ButtonGroupType.connected ? 2
    : size == ButtonSize.xs ? 18
    : size == ButtonSize.s ? 12
    : 8

// The corner between two items of a connected group.
//   xs 8, s 8, m 8, l 16, xl 20 (Compose has a token for the small size only: 8; the rest are
//   not in any token file). Pressed, an inner corner is 4.
private fn groupInnerRadius(size: ButtonSize) -> Int =>
    size == ButtonSize.l ? 16
    : size == ButtonSize.xl ? 20
    : 8

// How much wider the pressed item gets (half on each side) and its neighbours narrower: 15% of
// the pressed item's width (halved for a middle one, which grows both ways), at most the side
// padding of a neighbour (Compose's `compressionLimit`).
private fn groupGrowth(width: Float, middle: Bool, limit: Float) -> Float =>
    (middle ? 0.075 : 0.15) * width > limit ? limit : (middle ? 0.075 : 0.15) * width

// An icon-only item is as wide as it is tall: (height - icon) / 2 on each side.
private fn groupIconPad(size: ButtonSize) -> Int =>
    size == ButtonSize.xs ? 6 : size == ButtonSize.s ? 10 : size == ButtonSize.m ? 16 : size == ButtonSize.l ? 32 : 48

View ButtonGroup(items: List<Str>, bind selected: Int = 0, icons: List<Str> = [],
    type: ButtonGroupType = .standard, variant: ButtonVariant = .tonal, size: ButtonSize = .s,
    shape: ButtonShape = .round, selectable: Bool = true, icon_only: Bool = false,
    disabled: Bool = false, on_tap: Fn(Int) = none) {
    GroupRow(items, selectable ? [selected] : [], icons, type, variant, size, shape, selectable,
        icon_only, disabled, on_pick: {|i|
            if selectable {
                selected = i
            }
            on_tap(i)
        })
}

// The same group with any number of items on: `bind` is the list of their indices.
View MultiButtonGroup(items: List<Str>, bind chosen: List<Int> = [], icons: List<Str> = [],
    type: ButtonGroupType = .standard, variant: ButtonVariant = .tonal, size: ButtonSize = .s,
    shape: ButtonShape = .round, icon_only: Bool = false, disabled: Bool = false,
    on_tap: Fn(Int) = none) {
    GroupRow(items, chosen, icons, type, variant, size, shape, true, icon_only, disabled,
        on_pick: {|i|
            if chosen.contains(i) {
                chosen = chosen.filter(j => j != i)
            } else {
                chosen = chosen.push(i)
            }
            on_tap(i)
        })
}

// The row both share. `marked` says which indices are on.
private View GroupRow(items: List<Str>, marked: List<Int>, icons: List<Str>, type: ButtonGroupType,
    variant: ButtonVariant, size: ButtonSize, shape: ButtonShape, toggle: Bool, icon_only: Bool,
    disabled: Bool, on_pick: Fn(Int)) {
    // The item the pointer is down on, or -1, and its width at rest: a standard group reads them
    // to narrow the neighbours.
    var down = -1
    var downW = 0.0

    Row #[gap: groupGap(size, type), align: center, a11y_role: group] {
        for i, label in items {
            GroupItem(label, icons.len > i ? icons[i] : "", i, items.len, bind down: down, bind downW: downW,
                type: type, variant: variant, size: size, shape: shape, toggle: toggle,
                on: marked.contains(i), icon_only: icon_only, disabled: disabled,
                on_tap: { on_pick(i) })
        }
    }
}

// One item. A view so that its `let`s and the pointer var it shares with its neighbours stay
// out of the `for`.
private View GroupItem(label: Str, icon: Str, index: Int, count: Int, bind down: Int, bind downW: Float,
    type: ButtonGroupType, variant: ButtonVariant, size: ButtonSize, shape: ButtonShape,
    toggle: Bool, on: Bool, icon_only: Bool, disabled: Bool, on_tap: Fn() = none) {
    inject Theme as t

    let h = buttonHeight(size)
    let connected = type == ButtonGroupType.connected
    let flat = variant == ButtonVariant.outlined || variant == ButtonVariant.text
    let lineWidth = size == ButtonSize.l ? 2 : size == ButtonSize.xl ? 3 : 1
    let resting = toggle && !on

    let container = disabled ? (flat ? t.surface.alpha(0.0) : t.onSurface.alpha(disabledContainer))
        : variant == ButtonVariant.filled ? (resting ? t.surfaceContainer : t.primary)
        : variant == ButtonVariant.tonal ? (on ? t.secondary : t.secondaryContainer)
        : variant == ButtonVariant.elevated ? (on ? t.primary : t.surfaceContainerLow)
        : variant == ButtonVariant.outlined ? (on ? t.inverseSurface : t.surface.alpha(0.0))
        : t.surface.alpha(0.0)
    let ink = disabled ? t.onSurface.alpha(disabledContent)
        : variant == ButtonVariant.filled ? (resting ? t.onSurfaceVariant : t.onPrimary)
        : variant == ButtonVariant.tonal ? (on ? t.onSecondary : t.onSecondaryContainer)
        : variant == ButtonVariant.elevated ? (on ? t.onPrimary : t.primary)
        : variant == ButtonVariant.outlined ? (on ? t.inverseOnSurface : t.onSurfaceVariant)
        : t.primary
    let outlined = variant == ButtonVariant.outlined && !on
    let line = disabled ? t.onSurface.alpha(disabledContainer) : t.outlineVariant

    // Standard: one radius, round or square, flipped by selection. Connected: the outer corners
    // of the first and last are round and the rest small; a selected item is round all over.
    let square = (shape == ButtonShape.square) != on
    let single = square ? buttonSquareRadius(size) : h / 2
    let inner = groupInnerRadius(size)
    let cornerL = (on || index == 0) ? h / 2 : inner
    let cornerR = (on || index == count - 1) ? h / 2 : inner
    let pr = buttonPressedRadius(size)
    let pressL = index == 0 ? h / 2 : 4
    let pressR = index == count - 1 ? h / 2 : 4
    let pressedCorners = connected ? (pressL, pressR, pressR, pressL) : (pr, pr, pr, pr)
    let corners = connected ? (cornerL, cornerR, cornerR, cornerL) : (single, single, single, single)

    // Standard group: the pressed item widens (its own `on pressed`, so a key press does too) and
    // the ones beside it, which read `down` and `downW`, narrow. `cw` is what the item holds, so
    // its width at rest is `cw` and a side padding on each side.
    var cw = 0.0
    let base = (icon_only ? groupIconPad(size) : buttonPadding(size)) * 1.0
    let restW = cw + 2.0 * base
    let grows = !connected && count > 1
    let beside = grows && down >= 0 && (down == index - 1 || down == index + 1)
    let downMiddle = down > 0 && down < count - 1
    let narrow = beside ? groupGrowth(downW, downMiddle, base) / 2.0 : 0.0
    let selfMiddle = index > 0 && index < count - 1
    let own = groupGrowth(restW, selfMiddle, base)
    let widen = grows ? (selfMiddle ? own : own / 2.0) : 0.0
    let padX = base - narrow

    let restShadow = !disabled && variant == ButtonVariant.elevated ? "sm" : ()
    let hoverShadow = flat ? () : variant == ButtonVariant.elevated ? "md" : "sm"

    Row #[
        bg: container with t.springEffectsFast,
        radius: corners with t.springSpatialFast,
        border: line,
        border_width: outlined ? lineWidth : 0,
        shadow: restShadow,
        height: h,
        p: (0, padX) with t.springSpatialFast,
        align: center,
        justify: center,
        shrink: 0,
        a11y_role: toggle ? toggle_button : button,
        a11y_checked: on,
        a11y_label: label,
        disabled: disabled,
        pointer_down => {
            down = index
            downW = restW
        },
        pointer_up => down = -1,
        tap => on_tap(),
    ] {
        on hover { overlay: ink.alpha(stateHover) with t.springEffectsFast, shadow: hoverShadow }
        on focus_visible {
            overlay: ink.alpha(stateFocus) with t.springEffectsFast
            outline: t.secondary
            outline_width: focusRingWidth
            outline_offset: focusRingOffset
        }
        on pressed {
            overlay: ink.alpha(statePress) with t.springEffectsFast
            p: (0, padX + widen) with t.springSpatialFast
            radius: pressedCorners with t.springSpatialFast
        }

        Row #[gap: buttonGap(size), align: center, shrink: 0] {
            on measure => cw = it.w
            when icon != "" {
                Icon(icon, fill: on ? 1.0 : 0.0, size: buttonIconSize(size), color: ink)
            }
            when !icon_only {
                Text(label) #[
                    typo: (size == ButtonSize.xs || size == ButtonSize.s) ? t.labelLarge : size == ButtonSize.m ? t.titleMedium : size == ButtonSize.l ? t.headlineSmall : t.headlineLarge,
                    color: ink with t.springEffectsFast,
                    wrap: false,
                ]
            }
        }
    }
}
