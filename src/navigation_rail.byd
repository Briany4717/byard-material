// Material 3 Expressive navigation rail: a column of destinations at the start edge of a window,
// collapsed (an icon over a label, 96 wide) or expanded (icon and label side by side, a pill
// that spans the item, 220 wide), with a slot above the items for a menu button or a FAB.
//
//     var screen = 0
//     var open = false
//
//     m.NavigationRail(bind: screen, label: "Main", expanded: open,
//         header: { m.IconButton("menu", label: "Menu", on_tap: { open = !open }) }) {
//         m.NavigationRailItem(0, label: "Home", icon: "home")
//         m.NavigationRailItem(1, label: "Search", icon: "search")
//         m.NavigationRailItem(2, label: "Library", icon: "library_music", badge: { Badge() })
//     }
//
// The rail owns the selection (`bind: screen` is the caller's var; leave it out and the rail keeps
// its own). It does not decide when it is expanded: you do, with a var, and it springs between the
// two widths. What the rail decides (expanded or not, the selected index, how to select) it hands
// down in a context, so an item is written with only what is its own; an item outside a rail is
// collapsed with nothing selected. The expanded rail
// is what Expressive uses in place of a standard navigation drawer.
//
// `modal: true` with `open` and `on_close` adds Expressive's modal expanded rail, its replacement for the
// modal drawer: the collapsed rail stays in the layout, and while `open` is true an expanded one
// slides in over a scrim (an `Overlay`). The header slot is drawn in both, so one menu button
// that toggles `open` opens it and, inside, closes it. A tap on the scrim, Escape or choosing a
// destination closes it; it is a focus scope (focus goes in, Tab stays inside, and back to the
// menu button on close), and it slides and fades in and out.
//
//     m.NavigationRail(bind current: screen, modal: true, open: open, on_close: { open = false },
//         label: "Main",
//         header: { m.IconButton("menu", label: "Menu", on_tap: { open = !open }) }) { ... }
//
// Roles and keys are the navigation bar's: a `navigation` landmark around a `tab_list`, one Tab
// stop, the arrows move (Up and Down here, Left and Right too), Enter or Space selects. The
// header slot is outside the `tab_list`, so Tab reaches it on its own, before the items.
//
//   rail        96 wide collapsed, 220 expanded, `surface`, 44 above the first thing, 4 between items
//   header      40 below it before the first item
//   collapsed   as a bar item: pill 56 x 32, icon 24, 4 to the label, `label_medium`
//   expanded    56 high, the pill is the whole item (fully round), 16 before the icon, 8 between
//               icon and label, `label_large`
//   colours     as the bar's
//   modal       220 wide* (Material allows 220 to 360), surface_container*, end corners large (16)*,
//               level 2 shadow*, 32% scrim (the engine's); * not checked against the spec

private let railCollapsedWidth = 96
private let railExpandedWidth = 220
private let railTop = 44
private let railItemGap = 4
private let railHeaderGap = 40
private let railItemHeight = 64
private let railExpandedItemHeight = 56
private let railPillWidth = 56
private let railPillHeight = 32
private let railIconSize = 24
private let railLabelGap = 4
private let railWideGap = 8
private let railWidePadding = 16

// What the rail decides for its items. Private: only `NavigationRailItem` reads it.
private context NavigationRailStyle {
    current: Int = -1
    expanded: Bool = false
    select: Fn(Int) = none
}

View NavigationRail(content, bind current: Int = 0, header: Slot = none, expanded: Bool = false,
    label: Str = "Navigation", modal: Bool = false, open: Bool = false, on_close: Fn() = {}) {
    inject Theme as t

    RailColumn(bind current: current, header: header, expanded: expanded && !modal, label: label,
        modal: false) { content }

    // The modal expanded rail: over a scrim, from the start edge. A tap on the scrim or Escape
    // closes it, so does choosing a destination; it is a focus scope, and focus goes back to
    // what opened it.
    when modal && open {
        Overlay #[dismiss => on_close()] {
            RailColumn(bind current: current, on_close: on_close, header: header, expanded: true,
                label: label, modal: true) { content }
        }
    }
}

// The rail's column, collapsed, expanded or the modal panel (which is expanded, over the scrim).
private View RailColumn(content, bind current: Int = 0, on_close: Fn() = {}, header: Slot = none,
    expanded: Bool, label: Str, modal: Bool) {
    inject Theme as t

    provide NavigationRailStyle(expanded: expanded, current: current,
        select: {|i|
            current = i
            if modal {
                on_close()
            }
        })

    Column #[
        anchor: modal ? start : (),
        bg: modal ? t.surfaceContainer : t.surface,
        radius: modal ? (0, t.cornerLg, t.cornerLg, 0) : 0,
        shadow: modal ? "md" : (),
        width: (expanded ? railExpandedWidth : railCollapsedWidth) with t.springSpatialDefault,
        grow: modal ? 1 : 0,
        shrink: 0,
        translate: modal ? (0, 0) with t.springSpatialDefault : (),
        p: (railTop, expanded ? 20 : 0, 16, expanded ? 20 : 0),
        align: expanded ? stretch : center,
        a11y_role: modal ? dialog : navigation,
        a11y_label: label,
    ] {
        on enter { translate: (modal ? 0 - railExpandedWidth : 0, 0) }
        on leave { translate: (modal ? 0 - railExpandedWidth : 0, 0) }
        when header != none {
            Box #[mb: railHeaderGap - railItemGap, align_self: expanded ? start : center] {
                header
            }
        }
        Column #[
            a11y_role: tab_list,
            a11y_label: label,
            gap: railItemGap,
            align: expanded ? stretch : center,
        ] {
            content
        }
    }
}

View NavigationRailItem(index: Int, label: Str, icon: Str, badge: Slot = none,
    disabled: Bool = false, on_select: Fn() = {}) {
    inject Theme as t
    inject NavigationRailStyle as s

    let on = s.current == index
    let expanded = s.expanded

    let iconInk = disabled ? t.onSurface.alpha(disabledContent)
        : on ? t.onSecondaryContainer : t.onSurfaceVariant
    let labelInk = disabled ? t.onSurface.alpha(disabledContent)
        : on ? t.secondary : t.onSurfaceVariant
    let layer = on ? t.onSecondaryContainer : t.onSurface

    let pillHeight = expanded ? railExpandedItemHeight : railPillHeight

    Column #[
        height: expanded ? railExpandedItemHeight : railItemHeight,
        align: expanded ? stretch : center,
        justify: center,
        gap: railLabelGap,
        a11y_role: tab,
        a11y_selected: on,
        a11y_label: label,
        disabled: disabled,
        tap => {
            s.select(index)
            on_select()
        },
    ] as item {
        ZStack #[
            width: expanded ? () : railPillWidth,
            height: pillHeight,
            radius: pillHeight / 2,
            shrink: 0,
            alignment: center,
        ] {
            on item.hover { overlay: layer.alpha(stateHover) with t.springEffectsFast }
            on item.focus_visible {
                overlay: layer.alpha(stateFocus) with t.springEffectsFast
                outline: t.secondary
                outline_width: focusRingWidth
                outline_offset: focusRingOffset
            }
            on item.pressed { overlay: layer.alpha(statePress) with t.springEffectsFast }

            Box #[
                bg: t.secondaryContainer,
                radius: pillHeight / 2,
                align_self: stretch,
                grow: 1,
                scale.x: on ? 1.0 : 0.0 with t.springSpatialFast,
                origin: center,
            ] {}
            Row #[
                p: (0, expanded ? railWidePadding : 0),
                gap: railWideGap,
                align: center,
                justify: expanded ? start : center,
                align_self: stretch,
            ] {
                ZStack #[alignment: top_start] {
                    Icon(icon, fill: on ? 1.0 : 0.0, size: railIconSize, color: iconInk)
                    when badge != none {
                        Box #[ml: 14, mt: -2] { badge }
                    }
                }
                when expanded {
                    Text(label) #[
                        typo: on ? t.labelLargeEmphasized : t.labelLarge,
                        color: labelInk with t.springEffectsFast,
                        wrap: false,
                    ]
                }
            }
        }
        when !expanded {
            Text(label) #[
                typo: on ? t.labelMediumEmphasized : t.labelMedium,
                color: labelInk with t.springEffectsFast,
                wrap: false,
            ]
        }
    }
}
