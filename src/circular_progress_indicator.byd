// Material 3 Expressive circular progress indicator: determinate or indeterminate, flat or
// wavy, with the 4 dp gap between the active arc and the track. It starts at the top and runs
// clockwise.
//
//     m.CircularProgressIndicator(value: 0.4, label: "Download")
//     m.CircularProgressIndicator(indeterminate: true, label: "Loading")
//     m.CircularProgressIndicator(value: 0.7, wavy: true, label: "Sync")
//
// A flat one is 40 dp across and a wavy one 48 dp, the stroke 4 dp. A determinate value has a
// track; an indeterminate one is an arc that grows and shrinks while it turns, with none. An
// indeterminate indicator loops only while it is in the tree. The wave of a wavy one runs round
// the ring while it is shown (`animated: false` holds it). The active arc of a wavy ring is one
// stroked path whose radius follows a sine (`sin`, `cos`), round-capped; a wavy indeterminate
// one keeps a fixed length of 250 degrees: see the notes.

View CircularProgressIndicator(label: Str, value: Float = 0.0, indeterminate: Bool = false,
    wavy: Bool = false, animated: Bool = true) {
    inject Theme as t

    let d = wavy ? 48.0 : 40.0
    let c = d / 2.0
    let amp = wavy ? 1.6 : 0.0
    // Radius of the stroke's centre line.
    let r = c - 2.0 - amp
    let perDp = 57.29578 / r
    let cap = 2.0 * perDp
    let gap = progressGap * perDp
    let v = unit(value)
    let sweep = 360.0 * v

    Box #[
        width: d,
        height: d,
        shrink: 0,
        a11y_role: progress_bar,
        a11y_label: label,
        a11y_value: indeterminate ? "" : "{(v * 100.0).round()}",
        a11y_value_min: indeterminate ? none : 0,
        a11y_value_max: indeterminate ? none : 100,
    ] {
        when indeterminate {
            Box #[
                width: d,
                height: d,
                origin: center,
                rotate: 360deg with anim.linear(6s, from: 0deg, repeat: infinite),
            ] {
                when wavy {
                    WaveArc(d: d, r: r, from: 0.0, span: 250.0, amp: 1.6, animated: true)
                } else {
                    Box #[
                        width: d,
                        height: d,
                        origin: center,
                        rotate: 140deg with anim.linear(1333ms, from: 0deg, repeat: infinite),
                    ] {
                        Canvas #[width: d, height: d] {
                            arc(
                                cx: c,
                                cy: c,
                                r: r,
                                start: anim.keyframes(0%: -90 + cap, 50%: -90 + cap, 100%: 130 + cap, duration: 1333ms, loop: true),
                                sweep: anim.keyframes(0%: 30, 50%: 250 easeInOut, 100%: 30 easeIn, duration: 1333ms, loop: true),
                                stroke: t.primary,
                                stroke_width: 4,
                                cap: round,
                            )
                        }
                    }
                }
            }
        } else {
            ZStack #[width: d, height: d, alignment: top_start] {
                Canvas #[width: d, height: d] {
                    when v <= 0.0 {
                        arc(cx: c, cy: c, r: r, stroke: t.secondaryContainer, stroke_width: 4)
                    } else when v < 1.0 && 360.0 - sweep - 2.0 * gap - 2.0 * cap > 0.0 {
                        arc(
                            cx: c,
                            cy: c,
                            r: r,
                            start: -90.0 + sweep + gap + cap,
                            sweep: 360.0 - sweep - 2.0 * gap - 2.0 * cap,
                            stroke: t.secondaryContainer,
                            stroke_width: 4,
                            cap: round,
                        )
                    }
                    when !wavy && v >= 1.0 {
                        arc(cx: c, cy: c, r: r, stroke: t.primary, stroke_width: 4)
                    } else when !wavy && v > 0.0 {
                        arc(
                            cx: c,
                            cy: c,
                            r: r,
                            start: -90.0 + cap,
                            sweep: sweep - 2.0 * cap < 1.0 ? 1.0 : sweep - 2.0 * cap,
                            stroke: t.primary,
                            stroke_width: 4,
                            cap: round,
                        )
                    }
                }
                when wavy && v > 0.0 {
                    WaveArc(d: d, r: r, from: v >= 1.0 ? 0.0 : cap, span: v >= 1.0 ? 360.0 : sweep - 2.0 * cap, amp: 1.6 * waveRamp(v), animated: animated)
                }
            }
        }
    }
}

// The point at `t` degrees clockwise from the top, on a ring of radius `r` whose radius follows a
// sine of eight waves; `p` is how far through the one-second cycle (see `wsin`).
private fn wax(c: Float, r: Float, amp: Float, t: Float, p: Float) -> Float =>
    c + (r + amp * wsin(t / 45.0, p)) * ((t - 90.0) * 0.0174533).cos()
private fn way(c: Float, r: Float, amp: Float, t: Float, p: Float) -> Float =>
    c + (r + amp * wsin(t / 45.0, p)) * ((t - 90.0) * 0.0174533).sin()
// The i-th point's angle: every 3 degrees from `from`, the last one exactly at the end.
private fn at(from: Float, span: Float, i: Int) -> Float => i * 3.0 > span ? from + span : from + i * 3.0

// A wavy arc: `span` degrees from `from`, clockwise from the top, as one stroked path of straight
// pieces every 3 degrees, round caps and joins. The waves run along it while `animated`.
private View WaveArc(d: Float, r: Float, from: Float, span: Float, amp: Float, animated: Bool) {
    inject Theme as t

    let c = d / 2.0
    let n = (span / 3.0).ceil() + 1

    Canvas #[width: d, height: d] {
        when animated {
            path(stroke: t.primary, stroke_width: 4, cap: round, join: round) {
                move(anim.keyframes(0%: wax(c, r, amp, from, 0.0), 14%: wax(c, r, amp, from, 14.0), 29%: wax(c, r, amp, from, 29.0), 43%: wax(c, r, amp, from, 43.0), 57%: wax(c, r, amp, from, 57.0), 71%: wax(c, r, amp, from, 71.0), 86%: wax(c, r, amp, from, 86.0), 100%: wax(c, r, amp, from, 100.0), duration: 1s, loop: true), anim.keyframes(0%: way(c, r, amp, from, 0.0), 14%: way(c, r, amp, from, 14.0), 29%: way(c, r, amp, from, 29.0), 43%: way(c, r, amp, from, 43.0), 57%: way(c, r, amp, from, 57.0), 71%: way(c, r, amp, from, 71.0), 86%: way(c, r, amp, from, 86.0), 100%: way(c, r, amp, from, 100.0), duration: 1s, loop: true))
                for i in idx.slice(1, n.min(299)) {
                    line(anim.keyframes(0%: wax(c, r, amp, at(from, span, i), 0.0), 14%: wax(c, r, amp, at(from, span, i), 14.0), 29%: wax(c, r, amp, at(from, span, i), 29.0), 43%: wax(c, r, amp, at(from, span, i), 43.0), 57%: wax(c, r, amp, at(from, span, i), 57.0), 71%: wax(c, r, amp, at(from, span, i), 71.0), 86%: wax(c, r, amp, at(from, span, i), 86.0), 100%: wax(c, r, amp, at(from, span, i), 100.0), duration: 1s, loop: true), anim.keyframes(0%: way(c, r, amp, at(from, span, i), 0.0), 14%: way(c, r, amp, at(from, span, i), 14.0), 29%: way(c, r, amp, at(from, span, i), 29.0), 43%: way(c, r, amp, at(from, span, i), 43.0), 57%: way(c, r, amp, at(from, span, i), 57.0), 71%: way(c, r, amp, at(from, span, i), 71.0), 86%: way(c, r, amp, at(from, span, i), 86.0), 100%: way(c, r, amp, at(from, span, i), 100.0), duration: 1s, loop: true))
                }
            }
        } else {
            path(stroke: t.primary, stroke_width: 4, cap: round, join: round) {
                move(wax(c, r, amp, from, 0.0), way(c, r, amp, from, 0.0))
                for i in idx.slice(1, n.min(299)) {
                    line(wax(c, r, amp, at(from, span, i), 0.0), way(c, r, amp, at(from, span, i), 0.0))
                }
            }
        }
    }
}
