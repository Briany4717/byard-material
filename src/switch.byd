// Material 3 Expressive switch: a 52 x 32 track and a handle that grows when it is on and
// again while it is pressed. The handle can carry an icon (a check when on, a close when off,
// or one of your own).
//
//     m.Switch(bind: wifi, label: "Wi-Fi")
//     m.Switch(bind: wifi, label: "Wi-Fi", icons: true)
//     m.Switch(bind: wifi, label: "Dark", icons: true, icon: "dark_mode")
//
// `label` is what a screen reader says. Space or Enter flips it.
//
// Why composed, not the built-in `Toggle`: `Toggle` draws its own thumb with no way to size,
// recolour, put an icon on, or grow it. This is a `Row` with role `switch` and `bind on`.
//
// The track is named `as sw` and publishes its states: the handle and its 40 dp state layer,
// its children, write `on sw.hover`, `on sw.pressed` and `on sw.focus_visible` themselves, so
// the control keeps no `var`. Dragging the track moves the switch: the handle is `on` once the
// pointer is past the middle, and a press that does not move is a tap.
//
//   handle          off 16 (24 with an icon), on 24, pressed 28 (in `on sw.pressed`)
//   track           52 x 32, outline 2 dp when off
//   state layer     40 dp circle around the handle

private fn switchHandle(on: Bool, icon: Bool) -> Int => on ? 24 : icon ? 24 : 16

View Switch(bind on: Bool, label: Str = "", icons: Bool = false, icon: Str = "",
    disabled: Bool = false) {
    inject Theme as t

    let hasIcon = icons || icon != ""

    let track = disabled ? (on ? t.onSurface.alpha(disabledContainer) : t.surfaceContainerHighest.alpha(disabledContainer))
        : on ? t.primary : t.surfaceContainerHighest
    let line = disabled ? t.onSurface.alpha(disabledContainer) : t.outline
    let handle = disabled ? (on ? t.surface : t.onSurface.alpha(disabledContent))
        : on ? t.onPrimary : t.outline
    let handleLit = on ? t.primaryContainer : t.onSurfaceVariant
    let glyph = disabled ? (on ? t.onSurface.alpha(disabledContent) : t.surfaceContainerHighest.alpha(disabledContent))
        : on ? t.onPrimaryContainer : t.surfaceContainerHighest
    let layer = on ? t.primary : t.onSurface

    // The handle is drawn 28 across and scaled to its size, so growing it is a transform.
    let grow = switchHandle(on, hasIcon) / 28.0
    // Its centre: 16 from the left when off, 16 from the right when on.
    let shift = on ? 16 : -4

    Row #[
        bg: track with t.springEffectsFast,
        radius: 16,
        border: line with t.springEffectsFast,
        border_width: on ? 0 : 2,
        width: 52,
        height: 32,
        shrink: 0,
        align: center,
        a11y_role: switch,
        a11y_checked: on,
        a11y_label: label,
        disabled: disabled,
        tap => on = !on,
        drag(e) => on = e.x >= 26.0,
    ] as sw {
        on focus_visible {
            outline: t.secondary
            outline_width: focusRingWidth
            outline_offset: focusRingOffset
        }

        Box #[
            width: 40,
            height: 40,
            shrink: 0,
            radius: 20,
            bg: layer.alpha(0.0) with t.springEffectsFast,
            translate: (shift, 0) with t.springSpatialFast,
            align: center,
            justify: center,
        ] {
            on sw.hover { bg: layer.alpha(stateHover) with t.springEffectsFast }
            on sw.focus_visible { bg: layer.alpha(stateFocus) with t.springEffectsFast }
            on sw.pressed { bg: layer.alpha(statePress) with t.springEffectsFast }

            Box #[
                width: 28,
                height: 28,
                radius: 14,
                bg: handle with t.springEffectsFast,
                scale: grow with t.springSpatialFast,
                origin: center,
                align: center,
                justify: center,
            ] {
                on sw.hover { bg: handleLit with t.springEffectsFast }
                on sw.focus_visible { bg: handleLit with t.springEffectsFast }
                on sw.pressed {
                    bg: handleLit with t.springEffectsFast
                    scale: 1.0 with t.springSpatialFast
                }
                when hasIcon {
                    Box #[scale: 1.0 / grow with t.springSpatialFast, origin: center] {
                        on sw.pressed { scale: 1.0 with t.springSpatialFast }
                        Icon(icon != "" ? icon : on ? "check" : "close", size: 16, weight: 600,
                            color: glyph)
                    }
                }
            }
        }
    }
}
